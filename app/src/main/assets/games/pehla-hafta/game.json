      ],
      "audience": 3,
      "steps": [
        {
          "narrate": "सोमवार, सुबह साढ़े नौ बजे। नया ऑफ़िस, नया लैपटॉप, और कॉफ़ी मशीन के पास अजीब सी ख़ामोशी।",
          "voice_file": "audio/narrator_985749a10e8c.ogg"
        },
        {
          "enter": "vikram",
          "at": 0.6,
          "from": "right"
        },
        {
          "prop": "file_folder",
          "char": "vikram",
          "anchor": "hand_r"
        },
        {
          "say": "vikram",
          "text": "नए इंटर्न? बढ़िया। समय बर्बाद नहीं करेंगे।",
          "emotion": "neutral",
          "move": "walk",
          "voice_file": "audio/vikram_ef755516cd92.ogg"
        },
        {
          "say": "vikram",
          "text": "कल सुबह दस बजे क्लाइंट पिच है। और डेक आधा अधूरा पड़ा है।",
          "emotion": "determined",
          "move": "hold_phone",
          "voice_file": "audio/vikram_1ed66690364f.ogg"
        },
        {
          "prop": "none",
          "char": "vikram",
          "anchor": "hand_r"
        },
        {
          "say": "vikram",
          "text": "पूरा करना है — कल सुबह दस बजे तक। मंज़ूर है, या आज ही घर जाने का इरादा है?",
          "emotion": "angry",
          "move": "point",
          "voice_file": "audio/vikram_8dc6a47bf9ca.ogg"
        },
        {
          "say": "zoya",
          "text": "धीरे से: पहले ही दिन? ओह, बेचारी किस्मत।",
          "emotion": "smug",
          "move": "cross_arms",
          "voice_file": "audio/zoya_d04c0358f5e7.ogg"
        }
      ],
      "prompt": "Vikram Sir jawab ka intezaar kar rahe hain.",
      "choice": [
        {
          "text": "Done, sir. Kal 10 baje deck aapki table pe hoga 💼",
          "style": "confident",
          "score": 10,
          "effects": {
            "start_objective": "o1",
            "impression": 2,
            "himmat": 1
          },
          "goto": "w2",
          "reaction": [
            {
              "say": "vikram",
              "text": "अच्छा। आत्मविश्वास पसंद है। अब काम से साबित करो।",
              "emotion": "smile",
              "move": "nod",
              "voice_file": "audio/vikram_8f3df8167c23.ogg"
            },
            {
              "emote": "zoya",
              "emotion": "surprised"
            }
          ]
        },
        {
          "text": "Sir… main try {m:karunga|f:karungi}, par itna kam time…",
          "style": "timid",
          "score": 2,
          "effects": {
            "start_objective": "o1",
            "impression": -1
          },
          "goto": "w2",
          "reaction": [
            {
              "say": "vikram",
              "text": "ट्राई नहीं। करना है। यहाँ कोई हाथ नहीं पकड़ेगा।",
              "emotion": "disgusted",
              "move": "shake_head",
              "voice_file": "audio/vikram_d3c7bb7ef6b3.ogg"
            },
            {
              "say": "zoya",
              "text": "हम्म।",
              "emotion": "bored",
              "move": "shrug",
              "voice_file": "audio/zoya_c4c505ccd209.ogg"
            }
          ]
        },
        {
          "text": "Pehle hafte mein itna kaam? Ye fair nahi hai, sir.",
          "style": "rude",
          "score": 3,
          "effects": {
            "decline_objective": "o1",
            "impression": -3,
            "himmat": 2
          },
          "goto": "w2_zoya",
          "reaction": [
            {
              "say": "vikram",
              "text": "फ़ेयर? ठीक है। ज़ोया, डेक तुम्हारा। और तुम… देखते हैं किस काम के हो।",
              "emotion": "angry",
              "move": "turn",
              "voice_file": "audio/vikram_d767de75eb82.ogg"
            },
            {
              "exit": "vikram",
              "to": "right"
            }
          ]
        }
      ]
